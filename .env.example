# Create a Supabase project, then set both public values to enable cloud auth/data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional AI provider. These are used only by the server route; never expose them
# with a NEXT_PUBLIC_ prefix. OpenAI-compatible chat-completions endpoint.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
