# Copy to .env.production on the VPS and fill in real values. Do not commit .env.production.

# Required for Supabase auth/data (public values, but keep env file private on server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only AI provider (never use NEXT_PUBLIC_ prefix)
# Default Groq setup (recommended): set AI_API_KEY from https://console.groq.com/keys
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

NODE_ENV=production
